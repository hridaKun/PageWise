* text=auto

# Windows scripts and sources keep CRLF on checkout
*.ps1 text eol=crlf
*.cs text eol=crlf
*.manifest text eol=crlf

# Binary files
*.png binary
*.ico binary
*.gif binary
*.bcmap binary
*.pfb binary
*.ttf binary
*.icc binary
*.wasm binary

# Third-party PDF.js build: don't count it as project code on GitHub
engine/pdfjs/** linguist-vendored
